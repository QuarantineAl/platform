# Host-local state only. Everything under environments/<env>/ that
# `quarantine init` writes — manifest.yaml, compose.yaml, and the encrypted
# environments/<env>/secrets.sops.yaml — IS meant to be committed: SOPS
# ciphertext is safe in git by design (decision 6), and git is this
# platform's source of truth regardless of who applies a change (an
# operator or an environment's own self-hosted CI runner both reconcile
# from the committed manifest/compose/secrets, via `quarantine start` —
# see docs/runners-and-sandboxing.md).
#
# Only the DECRYPTED runtime artifacts and the age private key are excluded.

# decrypted env file generated by `quarantine start` from secrets + manifest
# (regenerated on every run; never hand-edited, never committed)
environments/*/.env

# second guard against decrypted secrets intermediates ever touching disk
# at a deployable path: `quarantine init` must go straight from
# secrets.example.yaml (the plaintext key-list template) to an already-
# SOPS-encrypted secrets.sops.yaml, never through a plaintext file at any
# of these names, but if one is ever accidentally created it should never
# be committable.
environments/*/secrets.yaml
environments/*/secrets.decrypted.yaml
environments/*/secrets.plain.yaml

# generate_env_file's own tempfile, co-located with .env for an atomic
# same-filesystem rename — never left behind on success, but excluded in
# case a killed run leaves one (it holds the same plaintext secrets as .env)
environments/*/.env.*

# rendered app configs that embed live secrets (e.g. Immich's OIDC client
# secret) — regenerated by `quarantine start`, never hand-edited, never
# committed, same rationale as environments/*/.env
environments/*/generated/

# per-environment quarantine CLI locks (flock targets, empty/advisory only)
/.quarantine-locks/

# age private keys must never live in the repo, in any environment,
# under any name — they live at /opt/quarantine/keys/ on the host only
# (see lib/common.sh QUARANTINE_KEYS_DIR and docs/client-install.md)
*.agekey
age-*.txt
**/keys/age-*

# host install config written by `quarantine init`
/quarantine.yaml

# editor/OS cruft
.DS_Store
*.swp
*~
