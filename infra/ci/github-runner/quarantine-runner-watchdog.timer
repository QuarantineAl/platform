# infra/ci/github-runner/quarantine-runner-watchdog.timer — checks every 2
# minutes whether the CI runner container is missing entirely and, if so,
# brings one up (see watchdog.sh for why this can't be done from inside CI
# itself). Manual install on the dev host, once:
#   ln -s /opt/quarantine/repo/infra/ci/github-runner/quarantine-runner-watchdog.service /etc/systemd/system/
#   ln -s /opt/quarantine/repo/infra/ci/github-runner/quarantine-runner-watchdog.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now quarantine-runner-watchdog.timer
# journalctl -u quarantine-runner-watchdog.service shows its run history.
[Unit]
Description=Run the quarantine CI runner watchdog every 2 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=30s

[Install]
WantedBy=timers.target
